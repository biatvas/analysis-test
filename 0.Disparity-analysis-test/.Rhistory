library(dplyr)
library(rstatix)
# Função de moda
get_mode <- function(x) {
uniq <- unique(x)
uniq[which.max(tabulate(match(x, uniq)))]
}
# Escolha a estatística que deseja calcular
estatistica_escolhida <- "media"   # opções: "media", "variancia", "desvio", "mediana", "moda"
# Mapeando os nomes para funções
estat_fun <- switch(estatistica_escolhida,
"media"    = function(x) mean(x, na.rm = TRUE),
"variancia"= function(x) var(x, na.rm = TRUE),
"desvio"   = function(x) sd(x, na.rm = TRUE),
"mediana"  = function(x) median(x, na.rm = TRUE),
"moda"     = get_mode)
# Aplicando no summarise
resultado <- dados %>%
summarise(across(c(OD, TH2O, pH, CE, Transp, MS),
estat_fun, .names = paste0(estatistica_escolhida, "_{col}")))
print(resultado)
