library(dplyr)
comp_spA <- c(2.56,2.56,2.57,2.57,2.58,2.59,2.59,2.61,2.61,2.61,2.71,2.75,3.27,3.28,3.19)
peso_spA <- c(0.413,0.449,0.311,0.322,0.321,0.300,0.335,0.309,0.486,0.350,0.525,0.572,0.687,0.630,0.902)
comp_spB <- c(2.21,2.41,2.31,2.42,2.20,2.46,2.14,2.42,2.31,2.21,2.32,2.23,2.61,2.74,2.84)
peso_spB <- c(0.143,0.196,0.167,0.180,0.168,0.214,0.178,0.219,0.229,0.159,0.190,0.182,0.243,0.30,0.382)
#Média das variáveis
dados <- data.frame(comp_spA, peso_spA, comp_spB, peso_spB)
dados %>%
summarise(across(everything(), mean))
#Amplitude para cada variável
diff(range(comp_spA)) ->amp_compA
diff(range(comp_spB)) ->amp_compB
diff(range(peso_spA)) ->amp_pesoA
diff(range(peso_spB)) ->amp_pesoB
print(amp_compA)
print(amp_pesoA)
print(amp_compB)
print(amp_pesoB)
## ================= variância, o desvio padrão, o coeficiente de variação e
# ====== o erro padrão da média de cada uma das variáveis
dados %>%
summarise(across(
c(comp_spA, comp_spB, peso_spA, peso_spB),
list(
media = ~mean(.),
desvio = ~sd(.),
variancia = ~var(.),
SE = ~sd(.)/sqrt(length(.)),                # erro padrão
CV = ~100 * sd(.) / mean(.)                 # coeficiente de variação (%)
),
.names = "{.col}_{.fn}"
))
